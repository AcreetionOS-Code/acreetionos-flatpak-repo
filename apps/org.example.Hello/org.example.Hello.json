{
  "app-id": "org.example.Hello",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "24.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "hello.sh",
  "modules": [
    {
      "name": "hello",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 hello.sh /app/bin/hello.sh",
        "install -Dm644 org.example.Hello.metainfo.xml /app/share/metainfo/org.example.Hello.metainfo.xml"
      ],
      "sources": [
        {
          "type": "script",
          "dest-filename": "hello.sh",
          "commands": [
            "echo 'Hello from AcreetionOS Flatpak!'"
          ]
        },
        {
          "type": "file",
          "path": "org.example.Hello.metainfo.xml"
        }
      ]
    }
  ],
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--share=ipc"
  ]
}
